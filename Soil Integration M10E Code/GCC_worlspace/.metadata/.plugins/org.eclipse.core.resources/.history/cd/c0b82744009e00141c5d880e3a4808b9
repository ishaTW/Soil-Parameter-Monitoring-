void SendAtCmd2(void)
{
	int fil_eret;
	int i,j;
	s32 fileret;
    bool exec = TRUE;

    switch (cam2_cmd_idx)
    {
    		//R_//OUT_D1EBUG(textBuf,"In FTP switch2\r\n");
    	case 1:// Echo mode off
    		Ql_sprintf((char *)cam_buffer, "ATE0\n");
    		//ftp_stuck.timeoutPeriod = Ql_SecondToTicks(560);
    		//ftp_stuck.timerId =0;
    		Ql_StartTimer(&GC_ftp_stuck);    ///timer for ftp stuck
    		cam_cmd_type2 = AT_General;
    		//R_//OUT_D1EBUG(textBuf,"Echo mode off ATE0 case 1 cam2\r\n");
    		//  check_AT_res();
        break;
        
    	case 2:// Select a foreground context
    		Ql_sprintf((char *)cam_buffer, "AT+QIFGCNT=0\n");
    		cam_cmd_type2 = AT_General;
    		//R_//OUT_D1EBUG(textBuf,"Select a foreground context AT+QIFGCNT=1 case 2\r\n\n");
    		//  check_AT_res();
        break;
        
    	case 3:// Select a bearer (0=CSD, 1=GPRS), if 'GPRS', set APN
    		Ql_sprintf((char *)cam_buffer, "AT+QICSGP=1,\"WWW\"\n");
    		cam_cmd_type2 = AT_General;
    		//R_//OUT_D1EBUG(textBuf,"Select a GPRS AT+QICSGP=1 case 3\n");
    		//   check_AT_res();
        break;
        
    	case 4:// Set user name
    		Ql_sprintf((char *)cam_buffer, "AT+QFTPUSER=\"%s\"\n", FTP_USER_NAME);
    		cam_cmd_type2 = AT_General;
    		//R_//OUT_D1EBUG(textBuf,"Set user name AT+QFTPUSER case 4\r\n\n");
    		//   check_AT_res();
    		break;
        
    	case 5:// Set password
    		Ql_sprintf((char *)cam_buffer, "AT+QFTPPASS=\"%s\"\n", FTP_PASSWORD);
    		cam_cmd_type2 = AT_General;
    		//R_//OUT_D1EBUG(textBuf,"Set password AT+QFTPPASS=1 case 5\r\n\n");
    		//   check_AT_res();
    		break;
        
    	case 6:// Open FTP
    		Ql_sprintf((char *)cam_buffer, "AT+QFTPOPEN=\"%s\",\"%s\"\n", FTP_SVR_ADDR, FTP_SVR_PORT);
    		cam_cmd_type2 = AT_QFTPOPEN;
    		//R_//OUT_D1EBUG(textBuf,"Open FTP AT+QFTPOPEN=1 case 6\r\n\n");
    		//   check_AT_res();
    		cam_bDoNexAT = FALSE;
    		break;
        
    	case 7:// Set local path
    		Ql_sprintf((char *)cam_buffer, "AT+QFTPCFG=4,\"/UFS/swap_file2.txt\"\n");
    		cam_cmd_type2 = AT_QFTPCFG;
    		//R_//OUT_D1EBUG(textBuf,"Set local path AT+QFTPCFG=4 case 7\r\n\n");
    		//   check_AT_res();
    		cam_bDoNexAT = FALSE;
    		break;
        
    	case 8:// Set server path
    		Ql_sprintf((char *)cam_buffer, "AT+QFTPPATH=\"%s\"\n", FTP_SVR_PATH);
    		cam_cmd_type2 = AT_QFTPPATH;
    		//R_//OUT_D1EBUG(textBuf,"Set server path AT+QFTPPATH=1 case 8\r\n\n");
    		//   check_AT_res();
    		cam_bDoNexAT = FALSE;
    		break;

    		/////////////////////not used//////////////////////////////////////
    		/*  case 9:// Start to download file
        	Ql_sprintf((char *)cam_buffer, "AT+QFTPGET=\"%s\"\n", appBin_fName_svr);
        	cam_cmd_type2 = AT_QFTPGET;
        	cam_bDoNexAT = FALSE;
        	break;
    		 	 */
    		/*    case 9:// Start to upload file
        	Ql_sprintf((char *)cam_buffer, "AT+QFTPPUT=\"801_002736A.txt\",%d,100\n",readedlen2);
        	cam_cmd_type2 = AT_QFTPPUT;
         	 //R_//OUT_D1EBUG(textBuf,"Start to upload file AT+QFTPPUT=1 case 9\n");
      	  //   check_AT_res();
        	cam_bDoNexAT = FALSE;
        	break;
    		 	 */   /////////////////////////////////////////////////////
      
    	case 9:// Start to upload file
    		++img_taken;
    		Ql_sprintf((char *)cam_buffer, "AT+QFTPPUT=\"%s\",%d,100\n",FTPFILENAME2,readedlen2);
    		cam_cmd_type2 = AT_QFTPPUT;
    		//   check_AT_res();
    		cam_bDoNexAT = FALSE;
    		break;
            
    	case 10:// List files
    		Ql_sprintf((char *)cam_buffer, "AT+QFLST\n");
    		cam_cmd_type2 = AT_General;
    		//R_//OUT_D1EBUG(textBuf,"List files AT+QFLST case 10\r\n\n");
    		//   check_AT_res();
    		break;
        
    	case 11:// Close FTP connection
    		Ql_sprintf((char *)cam_buffer, "AT+QFTPCLOSE\n");
    		cam_cmd_type2 = AT_QFTPCLOSE;
    		//R_//OUT_D1EBUG(textBuf,"Close FTP AT+QFTPCLOSE case 11\r\n\n");
    		//   check_AT_res();
    		cam_bDoNexAT = FALSE;
    		// Ql_StopTimer(&timer_ftp);
    		break;
        
    	case 12:// Deactivate GPRS PDP context
    		Ql_sprintf((char *)cam_buffer, "AT+QIDEACT\n");
    		cam_cmd_type2 = AT_General;
    		//R_//OUT_D1EBUG(textBuf,"Deactivate GPRS AT+QIDEACT case 12\r\n\n");
    		//    check_AT_res();
    		fileret=Ql_FileDelete((u8*)"swap_file2.txt");
    		//R_//OUT_D1EBUG(textBuf,"file delete fileret=%d\r\n",fileret);
    		//	FTP_TX_Flag=0;
    		cam_fl_up_flag=0;
    		break;

    	default:
    		//       //R_//OUT_D1EBUG(textBuf,"at commands finished.\r\n");
    		cam_cmd_type2 = AT_General;
    		exec = FALSE;
    		sen_fl=1;
    		cam_bDoNexAT = TRUE;
    		readcount22=readcount22+x2;
    		fun_cam2_read_cnt();
			//R_//OUT_D1EBUG(textBuf,"at commands finished default\r\n\n");
			tw_SD_fileread2();
			readedlen2=0;
			break;
    }
    if (exec)
    {
      //DC////R_//OUT_D1EBUG(textBuf,(char *)cam_buffer);
      Ql_SendToModem(ql_md_port1, (u8*)cam_buffer, Ql_strlen(cam_buffer));
    }
    return;
}

void cam_modemdata2(char *cam_modem_readbuffer2)
{
	if(FTP_TX_Flag==1)
   	{
		stop_img_capt=1;

		if (Ql_strstr((char *)cam_modem_readbuffer2, "Call Ready") != NULL)
		{
		}
		else if ((cam_cmd_type2 == AT_QFTPOPEN  && Ql_strstr((char*)cam_modem_readbuffer2,"+QFTPOPEN:0") != NULL)
				|| (cam_cmd_type2 == AT_QFTPCFG  && Ql_strstr((char*)cam_modem_readbuffer2, "+QFTPCFG:0")   != NULL)
				|| (cam_cmd_type2 == AT_QFTPPATH && Ql_strstr((char*)cam_modem_readbuffer2, "+QFTPPATH:0") != NULL)
				|| (cam_cmd_type2 == AT_QFTPPUT  && Ql_strstr((char*)cam_modem_readbuffer2, "+QFTPPUT:")   != NULL)
				|| (cam_cmd_type2 == AT_QFTPCLOSE && Ql_strstr((char*)cam_modem_readbuffer2, "+QFTPCLOSE:0") != NULL)
		)
		{
			cam2_cmd_idx++;
			cam_bDoNexAT = TRUE;
			SendAtCmd2();
		}
		else if ((  Ql_strstr((char*)cam_modem_readbuffer2, "\r\nOK") != NULL
				|| Ql_strstr((char*)cam_modem_readbuffer2, "OK\r\n") != NULL
				|| Ql_strstr((char*)cam_modem_readbuffer2, "ERROR") != NULL)
				&& cam_bDoNexAT != FALSE)
		{
			cam2_cmd_idx++;
			SendAtCmd2();
		}
   	}
	return;
 }
