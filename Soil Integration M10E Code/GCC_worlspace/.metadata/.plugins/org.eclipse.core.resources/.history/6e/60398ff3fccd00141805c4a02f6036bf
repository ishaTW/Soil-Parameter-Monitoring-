	////R_////OUT_D1EBUG(textBuf,"in tw_DistFromLatAndLong dist=%lf\r\n",dist);
	//Ql_Sleep(200);     
	return dist;
	//roundedValue=floorf(dist * 100 + 0.5) / 100;
	//roundedValue = ceilf(dist * 100) / 100;
	//roundedValue =floorf(dist * 100) / 100;
	//return roundedValue;
}


