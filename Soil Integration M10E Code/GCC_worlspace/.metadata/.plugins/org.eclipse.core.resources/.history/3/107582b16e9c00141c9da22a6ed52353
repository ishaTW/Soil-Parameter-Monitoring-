void tw_AvgSpeed1(void)
{
	static float mCurrTime = 0.000000,mTimeDiff = 0.000000;
	static float mPrevTime = 0.000000; 
    char *dist;
    char Dist[8];
	s32 ret2;
    static u8 Cnt;
    s32 ret1;
    u32 writeedlen1;
  
    char mSpeed[5];
    u32 readedlen1;
	char buffer[10];
	char *mpSpeed;
	//OUT_D1EBUG(textBuf,"\r\n##############mSpeedAscii######################:%s\r\n",mSpeedAscii);

	if((Ql_strncmp(str,"RMC",3)) || (Ql_strncmp(str,":RMC",4)))
	{		
		//   //OUT_D1EBUG(textBuf,"in  Avgspeed");

		if (!Ql_strncmp(STAT,"V",1))
		{
			//	//OUT_D1EBUG(textBuf,"\r\n V data\r\n");
		}
		else if (!Ql_strncmp(STAT,"A",1))
		{
			////OUT_D1EBUG(textBuf,"A data\r\n");
			//Time
			//Previous Time
			mPrevTimeAscii[6] = 0;
	        ////OUT_D1EBUG(textBuf,"mPrevTimeAscii1:%s\r\n",mPrevTimeAscii);
			mPrevTime = tw_ReturnSec(mPrevTimeAscii);
	        ////OUT_D1EBUG(textBuf,"mPrevTime:%f\r\n",mPrevTime);
			//Current time
			Ql_memset(par40,0,sizeof(par40));
			Ql_strncpy(par40,TIME,6);
			Ql_strncat(par40,"\0",1);
			mCurrTime = tw_ReturnSec(par40);
			
			Ql_memset(mPrevTimeAscii,0,sizeof(mPrevTimeAscii));
			Ql_strncpy(mPrevTimeAscii,par40,6);
			mPrevTimeAscii[6] = 0;
			//Speed
			//Added 0 at end of array to avoid garbage
			//Previous Speed
			mSpeedAscii[5] = 0;  

			//OUT_D1EBUG(textBuf,"\r\n++++++++++++ in Avgspeed +++++++++++++++++");

			//OUT_D1EBUG(textBuf,"First RA_Prespeed:%f\r\n",RA_Prespeed);
			//extraraprespeed=raprespeed;
	//		extraraprespeed=RA_Prespeed;        ///chnaged due to value becoming zero
		//	OUT_D1EBUG(textBuf,"Before extraraprespeed:%f\r\n",extraraprespeed);

			//OUT_D1EBUG(textBuf,"\r\n********mSpeedAscii:%s\r\n",mSpeedAscii);
			//mPrevSpeed = (Ql_atof(mSpeedAscii)) * mMultiFactorSpeed;
			mPrevSpeed = atofd(mSpeedAscii) * 1.852;
			//OUT_D1EBUG(textBuf,"\r\n********mPrevSpeed:%f\r\n",mPrevSpeed);
			extraraprespeed=mPrevSpeed;
			//OUT_D1EBUG(textBuf,"Before extraraprespeed:%f\r\n",extraraprespeed);
			//Current Speed
			Ql_memset((ascii *)mSpeed,0,sizeof(mSpeed));
			Ql_strcpy((ascii *)mSpeed,SPEED);
			//OUT_D1EBUG(textBuf,"  Ascii SPEED=%s\r\n",SPEED);
			mCurrSpeed = atofd((ascii *)mSpeed) * 1.852;
			//raprespeed=mCurrSpeed;
			RA_Prespeed = mCurrSpeed;
			//OUT_D1EBUG(textBuf,"*********mCurrSpeed:%f\r\n",mCurrSpeed);
			//OUT_D1EBUG(textBuf,"Second raprespeed:%f\r\n",RA_Prespeed);
			//	//OUT_D1EBUG(textBuf,"mCurrSpeed:%f\r\n",mCurrSpeed);
			mpSpeed=ix_Ftoa(mCurrSpeed,2);
			Ql_memset(mSpeedAscii,0,sizeof(mSpeedAscii));
			Ql_strncpy(mSpeedAscii,mSpeed,5);
			//OUT_D1EBUG(textBuf,"\r\n********mSpeedAscii*******************:%s\r\n",mSpeedAscii);
			//	//OUT_D1EBUG(textBuf,"LATbefr:%s\r\n",LAT);
			//Current Lat and Long					
			Ql_memset(mCurrLatLong,0,sizeof(mCurrLatLong));
			//Lat
			//Ql_strncat((ascii *)mCurrLatLong,":",1);
			Ql_strncat((ascii *)mCurrLatLong,LAT,10);						
			mCurrLat = atofd(LAT);		
			//OUT_D1EBUG(textBuf,"mCurrLat1 before:%s\r\n",LAT);
			//OUT_D1EBUG(textBuf,"mCurrLat1 before:%f\r\n",mCurrLat);
			//Long
			Ql_strncat((ascii *)mCurrLatLong,",",1);
			Ql_strncat((ascii *)mCurrLatLong,LONG,10);			
			mCurrLong = atofd(LONG);
			//	Ql_strncat((ascii *)mCurrLatLong,",-",2);
			Ql_strncat((ascii *)mCurrLatLong,"\0\0",2);

			//Time differance
			if (mCurrTime > mPrevTime)
			{
				mTimeDiff = mCurrTime - mPrevTime;
				//OUT_D1EBUG(textBuf,"Time diff1:%f\r\n",mTimeDiff);
			}	
			else
			{

			}	
			
			//Distance calculation using speed
			//Check if time difference(between current & previous time) is greater than 1 or less than equal to 10

			if ((mTimeDiff >= 1) && (mTimeDiff <= mTimeDiffLimit))
			{
				////OUT_D1EBUG(textBuf,"Dist clac by speed\r\n");
				//Then calculate by avg speed by taking the two end speeds
				if(mCurrSpeed <= 300.000000 && mCurrSpeed > 3.000000)
				{
					//Checking condition for sure that in 10 sec max 1 meter cab travelled.only
					////OUT_D1EBUG(textBuf,"\nin current\r\n");
					//extraraprespeed
					if((extraraprespeed + mCurrSpeed)/2 * (mTimeDiff/3600) < 1.1) //////**&&&&&&&&&&&&changed extraraprespeed
					{
					    mTotDist = mTotDist + ((extraraprespeed + mCurrSpeed)/2 * (mTimeDiff/3600));
					    //  OUT_D1EBUG(textBuf,"Dist:%f\r\n",mTotDist);
					}
					else
					{
						////OUT_D1EBUG(textBuf,"Current speed < 300***2\r\n");
					}
				}
				else
				{
					////OUT_D1EBUG(textBuf,"Current speed < 300***3\r\n");
				}
			}
			
			//Distance calculation using LAT & LONG
			//  //OUT_D1EBUG(textBuf,"Time diff limit:%f\r\n",mTimeDiffLimit);
			// //OUT_D1EBUG(textBuf,"Time diff:%f\r\n",mTimeDiff);
	        
			else if((mTimeDiff > mTimeDiffLimit) && (mTimeDiff !=mCurrTime))
			{		
				//	//OUT_D1EBUG(textBuf,"Dist clac by lat & long\r\n");
				//Read previous lat & long from memory
				////OUT_D1EBUG(textBuf,"In file write func\r\n");
				//  //OUT_D1EBUG(textBuf,"LatLongfile = %s\r\n",pfile2);
				//OUT_D1EBUG(textBuf,"Calling function tw_LatLong_read from GPS.c\r\n");
				tw_LatLong_read();   //Read previous Lat & Long
				
				if((Ql_strlen((ascii *)mPrevLatLong) > 16) && (Ql_strlen((ascii *)mCurrLatLong) > 16)) 
				{
					//Read Lat & Long separate in 2 different functions
					ReadLatLong();
				}
			}	
			
		else
		{
			
			//Calculate distance by speed
			//		//OUT_D1EBUG(textBuf,"Calculate distance by speed***1\r\n");

			if (mCurrSpeed <= 300.000000 && mCurrSpeed > 3.000000)
			{
				if((mCurrSpeed/3600) < 0.1) //shital //in 1 sec maximum o.03 diatsnce can travelled for safe side we check for 100 meters i.e0.1
				{
					mTotDist = mTotDist + (mCurrSpeed/3600);
					//		  //OUT_D1EBUG(textBuf,"Dist by speed=%f\r\n",mTotDist);
				}
				else
				{
				}
				
			}
			else
			{
			}
		}
			ret2 = Ql_FileOpenEx((u8 *)pfile1,QL_FS_CREATE);

			if(ret2 >= QL_RET_OK)
			{
				LatLongfilehandle = ret2;
				wcnt1=5+1;
				ret2 = Ql_FileSeek(LatLongfilehandle,wcnt1,QL_FS_FILE_BEGIN);
				//	//OUT_D1EBUG(textBuf,"Globalstring=%s\r\n",Globalstring);
				//	//OUT_D1EBUG(textBuf,"Globalstring=%d\r\n",Ql_strlen((char *)Globalstring));
				ret2 = Ql_FileWrite(LatLongfilehandle,(u8*)mCurrLatLong,30,&LatLongwriteedlen);
				//	    //OUT_D1EBUG(textBuf,"Ql_FileWrite()=%d: LatLongwriteedlen=%d\r\n",ret2,LatLongwriteedlen);
				Ql_FileClose(LatLongfilehandle);
				LatLongfilehandle = -1;
				   
			}
			else
			{
				//	//OUT_D1EBUG(textBuf,"Error in file LatLongfile writing\r\n");
			}

			////////////////////////////////////////----------------------///////////////////////////////////
			//Logic for Stop Stamp:- Check if speed is zero or non-zero for 60secs continously,
			//then only generate stop or start stamps respectively after 60th second
			//Stop Stamp
			if(mCurrSpeed <= 3.00000)  // Changed from 1 to 3 on 23 Aug 2012
			{
				prvRMC_store();          //store RMC string
				clrcam1flags();
				clrcam2flags();
				//camcaptureflag=0;
				//camindicatorflag=0;
				camcaptureflag=0;
				camindicatorflag=0;
				//Ql_StopTimer(&cap_intv);
				//Ql_StopTimer(&timer_1);
				Ql_StopTimer(&onesecdummy);
				//onesecdummy.timerId =0;

				if(mCountNotMoving < (mStopDuration/3))
				{
					if(mCountMoving < (mStartDuration/3))
					{
						mCountMoving=0;
					}
					else
					{
					}
					mCountNotMoving++;
				}				
				else if((mCountNotMoving >= (mStopDuration/3)) && (mCountNotMoving < mStopDuration))
				{
					mCountMoving = 0;
					mCountNotMoving	++;
				}		
				else if(mCountNotMoving == mStopDuration)
				{
					mCountMoving =0;
					mCountNotMoving++;

					if(mVehMoving == TRUE)
					{
						Ql_memset(StopStampString,0,sizeof(StopStampString));
						Ql_strncpy(StopStampString,UID,7);
						Ql_strncat(StopStampString,"_SP,",4);
						Ql_strcat(StopStampString,GPRMC);
						//Ql_strcat(StopStampString,mSpeedAscii);  //Speed
						//ix_Ftoa(mCurrSpeed,2);
					    ix_Itoa(mCurrSpeed);
					    ////OUT_D1EBUG(textBuf,"FtoaStrcurre%s\r\n",ItoaStr);
				        Ql_strcat(StopStampString,(char *)ItoaStr);///mCurrSpeed speed
	                    Ql_strncat(StopStampString,",",1);
						Ql_strcat(StopStampString,(ix_Itoa(mTotDist)));	//Distance
						Ql_strncat(StopStampString,",",1);
						Ql_strncat(StopStampString,"0.0",3);						//PDOP
						Ql_strncat(StopStampString,",",1);
						Ql_strcat(StopStampString,STAT);							//Status (A/V)
						Ql_strncat(StopStampString,"\r\n",2);
						//OUT_D1EBUG(textBuf,"%s\r\n",StopStampString);
						tw_filewrite((char *)StopStampString);
						mVehMoving = FALSE;
						Flag_Writebuffer=mVehMoving;
						ret1 = Ql_FileOpenEx((u8*)pfile1,QL_FS_CREATE);

						if(ret1 >= QL_RET_OK)
						{
							filehandle1 = ret1;
							ret1 = Ql_FileSeek(filehandle1,0,QL_FS_FILE_BEGIN);
							//Flag_wrt_cnt+=Ql_strlen(mVehMoving);
						    //ret1 = Ql_FileWrite(filehandle1, (u8 *)Flag_Writebuffer,1,&writeedlen1);
						    ////OUT_D1EBUG(textBuf,"Flag_Writebuffer=%d\r\n",Flag_Writebuffer);
						    ret1 = Ql_FileWrite(filehandle1, (u8 *)"FALSE",5,&writeedlen1);
						    //OUT_D1EBUG(textBuf,"Flag_Writebuffer=FALSE\r\n");
						    Ql_FileClose(filehandle1);
	    					filehandle1 = -1;
						}
					}
				}	
			}

			//Start Stamp
			if(mCurrSpeed > 3.00000)        // Changed from 1 to 3 on 23 Aug 2012
			{
				prvRMC_store();          //store RMC string
				if(stop_acc_capt==0)
				{
					tw_writeAccData(checkdata);
				}
				camcaptureflag=1;
				
				if(camindicatorflag==0)
				{
					camindicatorflag=1;
				}
				
				if(mCountMoving <(mStartDuration/3))
				{
					if(mCountNotMoving <(mStopDuration/3))
					{
						mCountNotMoving=0;
					}
					else
					{
					}
					mCountMoving++;
				}				
				else if((mCountMoving >= (mStartDuration/3)) && (mCountMoving < mStartDuration))
				{
					mCountMoving++;
					mCountNotMoving	= 0;
				}		
				else if(mCountMoving == mStartDuration)
				{
					mCountMoving++;
					mCountNotMoving = 0;
					
					if(mVehMoving == FALSE)
					{
						//mVehMoving = TRUE;
						Ql_memset(StartStampString,0,sizeof(StartStampString));
						Ql_strncpy(StartStampString,UID,7);
						Ql_strncat(StartStampString,"_ST,",4);
						Ql_strcat(StartStampString,GPRMC);
						//	Ql_strcat(StartStampString,mSpeedAscii);
						//    ix_Ftoa(mCurrSpeed,2);
	                    ix_Itoa(mCurrSpeed);
	                    ////OUT_D1EBUG(textBuf,"FtoaStrcurre%s\r\n",ItoaStr);
	                    Ql_strcat(StartStampString,(char *)ItoaStr);///mCurrSpeed speed
	                  
	                    Ql_strncat(StartStampString,",",1);
						Ql_strcat(StartStampString,(ix_Itoa(mTotDist)));	//Distance
						 Ql_strncat(StartStampString,",",1);
						Ql_strncat(StartStampString,"0.0",3);						//PDOP
						Ql_strncat(StartStampString,",",1);
						Ql_strcat(StartStampString,STAT);							//Status (A/V)
						Ql_strncat(StartStampString,"\r\n",2);		
						//OUT_D1EBUG(textBuf,"%s\r\n",StartStampString);
						tw_filewrite((char *)StartStampString);
						mVehMoving = TRUE;
						Flag_Writebuffer=mVehMoving;
						ret1 = Ql_FileOpenEx((u8*)pfile1,QL_FS_CREATE);
						if(ret1 >= QL_RET_OK)
						{
							filehandle1 = ret1;
							ret1 = Ql_FileSeek(filehandle1,0,QL_FS_FILE_BEGIN);
						    ////OUT_D1EBUG(textBuf,"Flag_Writebuffer=%d\r\n",Flag_Writebuffer);
						    ret1 = Ql_FileWrite(filehandle1, (u8*)"TRUE",4,&writeedlen1);
						    //    //OUT_D1EBUG(textBuf,"Flag_Writebuffer=TRUE\r\n");
						    Ql_FileClose(filehandle1);
	    					filehandle1 = -1;
						}
					}
				}	
			}
		
			////////////////////////////////////////----------------------///////////////////////////////////
			//AC/DC logic:- Check the time difference between two consecutive RMC strings in the range 1 - 3
			//Generate AC/DC stamps only if the above condition matches
		//	if((3 >= mTimeDiff) && (mTimeDiff >= 1))
			if((mTimeDiff <= 3 ) && (mTimeDiff >= 1))
			{
				//OUT_D1EBUG(textBuf,"in AC_DC mTimeDiff=%f",mTimeDiff);
				//	//OUT_D1EBUG(textBuf,"mTimeDiff is 1 - 3\r\n");
				//OUT_D1EBUG(textBuf,"mTimeDiff=%f\r\n",mTimeDiff);
				//OUT_D1EBUG(textBuf,"\rnextraraprespeed:%f\r\n",extraraprespeed);
				//OUT_D1EBUG(textBuf," mCurrSpeed:%f\r\n",mCurrSpeed);
		 		mAccDcLimit_1=( mAccDcLimit )*( mTimeDiff );
		 		//OUT_D1EBUG(textBuf," mTimeDiff=%f\r",mTimeDiff);
		 		//OUT_D1EBUG(textBuf," mAccDcLimit=%f\r\n",mAccDcLimit);
		 		//OUT_D1EBUG(textBuf,"cal mAccDcLimit_1=%f\r\n",mAccDcLimit_1);
				
				//if((mPrevSpeed - mCurrSpeed) >= mAccDcLimit_1)
				if((extraraprespeed - mCurrSpeed) >= 15.0)
				{
					Ql_memset(DCStampString,0,sizeof(DCStampString));
					Ql_strncpy(DCStampString,UID,7);
					Ql_strncat(DCStampString,"_DC,",4);

					Ql_strcat(DCStampString,GPRMC);
		//			Ql_strcat(DCStampString,(ix_Itoa(mTotDist)));	//Distance
					//Ql_strcat(DCStampString,mSpeedAscii);
				//	ix_Ftoa(mCurrSpeed,2);
					ix_Itoa(mCurrSpeed);
	//				//OUT_D1EBUG(textBuf,"FtoaStrcurre%s\r\n",ItoaStr);
				    Ql_strcat(DCStampString,(char *)ItoaStr);///mCurrSpeed speed
				    Ql_strncat(DCStampString,",",1);
				    
			//	    ix_Ftoa(mPrevSpeed,2);
				    ix_Itoa(extraraprespeed);
		//			//OUT_D1EBUG(textBuf,"FtoaStrprev%s\r\n",ItoaStr);
				    Ql_strcat(DCStampString,(char *)ItoaStr);///mPrevSpeed speed
				    Ql_strncat(DCStampString,",",1);
				    		
					//Ql_strncat(DCStampString,",",1);
					//Ql_strncat(DCStampString,"mCurrSpeed",1);
					Ql_strncat(DCStampString,"0.0",3);	//PDOP
					Ql_strncat(DCStampString,",",1);
					Ql_strcat(DCStampString,STAT);		//Status (A/V)
					Ql_strncat(DCStampString,"\r\n",2);		
				//	tw_filewrite((char *)DCStampString);
					//OUT_D1EBUG(textBuf,"%s\r\n",DCStampString);
					tw_filewrite(DCStampString);
				}
			//	else if((mCurrSpeed - mPrevSpeed) >= mAccDcLimit_1)
				else if((mCurrSpeed - extraraprespeed) >= 15.0)
		 		{
		 			//OUT_D1EBUG(textBuf,"AC ____mAccDcLimit_1=%f\r\n",mAccDcLimit_1);
					Ql_memset(ACStampString,0,sizeof(ACStampString));
//					Ql_strncpy(ACStampString,"UI8002_AC,",10);
					Ql_strncpy(ACStampString,UID,7);
					Ql_strncat(ACStampString,"_AC,",4);

					Ql_strcat(ACStampString,GPRMC);
				//	Ql_strcat(ACStampString,(ix_Itoa(mTotDist)));	//Distance
				//	Ql_strcat(ACStampString,mSpeedAscii);
				//	ix_Ftoa(mCurrSpeed,2);
					ix_Itoa(mCurrSpeed);
