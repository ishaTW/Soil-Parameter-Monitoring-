double tw_sqrt(double m)
{
	double c=0,b=0;
	double x1,x2;
	while( (c*c) <= m )
	c+=0.1;
	x1=c;
	
	for( b=0;b<10;b++)
	{
		x2=m;
		x2/=x1;
		x2+=x1;
		x2/=2;
		x1=x2;
	}
	return x2;
}


