/*  Function   : RMC time conversion	                                   */
/*-------------------------------------------------------------------------*/
/*  Object     : time convert to seconds					               */
/*-------------------------------------------------------------------------*/

float tw_ReturnSec(char mHHMMSS[6])
{
	float mTotSec = 0;
	//ascii mTemp[3] = {0};
    ascii mTemp[3] = {0};
	mTemp[0] = mHHMMSS[0];
	mTemp[1] = mHHMMSS[1];
	mTemp[2] = 0;
	//mTotSec = mTotSec + (Ql_atoi((ascii *)mTemp) * 3600);
	mTotSec = mTotSec + (Ql_atoi(mTemp) * 3600);
	mTemp[0] = mHHMMSS[2];
	mTemp[1] = mHHMMSS[3];
	mTemp[2] = 0;
	//mTotSec = mTotSec + (Ql_atoi((ascii *)mTemp) * 60);
	mTotSec = mTotSec + (Ql_atoi(mTemp) * 60);
	mTemp[0] = mHHMMSS[4];
	mTemp[1] = mHHMMSS[5];
	mTemp[2] = 0;
	//mTotSec = mTotSec + Ql_atoi((ascii *)mTemp);
	mTotSec = mTotSec + Ql_atoi(mTemp);
	return mTotSec;
}
