//-------------------------------------------------------------------------


double dist_lat_long(double lat1,double long1,double lat2,double long2)
{
	double x,y,dist;
	//	//OUT_D1EBUG(textBuf,"lat2= %f\r\n",lat2);
	//	//OUT_D1EBUG(textBuf,"lat1= %f\r\n",lat1);
	//	//OUT_D1EBUG(textBuf,"long2= %f\r\n",long2);
	//	//OUT_D1EBUG(textBuf,"long1= %f\r\n",long1);
	x = (69.1 * (lat2 - lat1));
	y = (53.0 * (long2 - long1));
	
	dist = (1.6 * (tw_sqrt(x * x + y * y)));
	//OUT_D1EBUG(textBuf,"dist= %f\r\n",dist);
	return dist;
}



