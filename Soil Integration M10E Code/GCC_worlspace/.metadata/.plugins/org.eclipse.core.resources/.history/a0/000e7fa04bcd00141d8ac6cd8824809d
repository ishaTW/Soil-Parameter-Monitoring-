/////Store Camera tx and RX
void Cam_Tx_Rx(char *Tx_int,char *Rx_int)
{

	s32 ret;
	u32 writeedlen;
	u8 k;
	s32 filehandle=-1;

	ret = Ql_FileOpenEx(PATH_CANPARA,QL_FS_CREATE);

	if(ret >= QL_RET_OK)
	{
		filehandle = ret;
		//R_//OUT_D1EBUG(textBuf,"camera capture Rx_int=%s\r\n",Rx_int);
		ret = Ql_FileSeek(filehandle,77,QL_FS_FILE_BEGIN);
		Ql_Sleep(200);
		ret = Ql_FileWrite(filehandle,(u8 *)Rx_int,6,&writeedlen);
		//R_//OUT_D1EBUG(textBuf,"Ql_Camera capture interval()=%d: writeedlen=%d\r\n",ret,writeedlen);
		/////-----------------------Write Remote Stamping in to memory-------------------------------/////
		Ql_Sleep(200);
		//R_//OUT_D1EBUG(textBuf,"camera transmission Tx_int=%s\r\n",Tx_int);
		ret = Ql_FileSeek(filehandle,70,QL_FS_FILE_BEGIN);
		Ql_Sleep(200);
		ret = Ql_FileWrite(filehandle,(u8 *)Tx_int,6,&writeedlen);
		//R_//OUT_D1EBUG(textBuf,"Ql_CanCam_TxWrite()=%d: writeedlen=%d\r\n",ret,writeedlen);
		Ql_FileClose(filehandle);
		filehandle = -1;
	}
}
//use memloc 90 for OS speed

void OS_Lmt_wrt(char *OS_L)
{

	s32 ret;
	u32 writeedlen;
	u8 k;
	s32 filehandle=-1;

	ret = Ql_FileOpenEx(PATH_CANPARA,QL_FS_CREATE);

	if(ret >= QL_RET_OK)
	{
		filehandle = ret;
		//R_//OUT_D1EBUG(textBuf,"OS speed Limit=%s\r\n",OS_L);
		ret = Ql_FileSeek(filehandle,90,QL_FS_FILE_BEGIN);								///Mem loc 90 from this file  use next from 100
		Ql_Sleep(200);
		ret = Ql_FileWrite(filehandle,(u8 *)OS_L,8,&writeedlen);
		//R_//OUT_D1EBUG(textBuf,"Ql_Camera capture interval()=%d: writeedlen=%d\r\n",ret,writeedlen);

		Ql_FileClose(filehandle);
		filehandle = -1;
	}
