void newunit_id(char * unit_id)
{
    u8 i;
    s32 ret1;
    u32 writeedlen;
    s32 filehandle=-1;
    char tempuid[8];
	ret1 = Ql_FileOpenEx(PATH_CANPARA,QL_FS_CREATE);//open the file or else create the file
	//	//R_//OUT_D1EBUG(textBuf,""ret=%d\r\n",ret1);
    if(ret1 >= QL_RET_OK)
    {
        tempuid[0]='U';
	    tempuid[1]='I';
		tempuid[2]=unit_id[0];
		tempuid[3]=unit_id[1];
		tempuid[4]=unit_id[2];
		tempuid[5]=unit_id[3];
		tempuid[6]='\0';
        filehandle = ret1;    
        ret1 = Ql_FileSeek(filehandle,1,QL_FS_FILE_BEGIN);
        
        //ret1 = Ql_FileWrite(filehandle, (u8*)UID,Ql_strlen((char *)UID),&writeedlen);
        ret1 = Ql_FileWrite(filehandle, (u8*)tempuid,8,&writeedlen);
        ////R_//OUT_D1EBUG(textBuf,""\r\n Ql_FileWriteUID()=%d: writeedlen=%d\r\n",ret1, writeedlen);
        //R_//OUT_D1EBUG(textBuf,"Unit ID is=%s\r\n",tempuid);
        Ql_FileClose(filehandle);
	    filehandle = -1;
    }	
    else
    {
       //R_//OUT_D1EBUG(textBuf,"error in UID write\r\n");
    }
}	   	    



